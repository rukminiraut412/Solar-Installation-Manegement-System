# ==============================================================================
# Solar Installation Management System - Unified Environment Configuration
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solar_management_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solar_management_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Authentication & Security
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRY=7d
SALT_ROUNDS=12

# Cloudinary (Media / Site Surveys / Quotation Signatures)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (Payments - Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Client Frontend
VITE_API_BASE_URL=http://localhost:5000/api/v1
