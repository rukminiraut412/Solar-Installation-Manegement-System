PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solar_management_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solar_management_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Auth Secrets
JWT_ACCESS_SECRET=super_secret_jwt_access_token_key_change_in_production_32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_32chars
JWT_REFRESH_EXPIRY=7d
SALT_ROUNDS=12

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
